{
	"schemaVersion": 1,
	"id": "madoku-craft-core",
	"version": "${version}",
	"name": "Madoku Craft Core",
	"description": "A foundational piece required by Madoku Craft mods.",
	"authors": [
		"Monkeyopolis"
	],
	"contact": {
		"sources": "https://github.com/Monkeyopolis/Madoku-Craft-Core"
	},
	"license": "CC0-1.0",
	"icon": "assets/madoku-craft-core/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"madoku.craft.java.MadokuCraftCore"
		],
		"client": [
			"madoku.craft.java.MadokuCraftCoreClient"
		]
	},
	"mixins": [
		"madoku-craft-core.mixins.json",
		"madoku-craft-core.sodium.mixins.json"
	],
	"depends": {
		"fabricloader": "${loader_version}",
		"minecraft": "~${minecraft_version}",
		"java": ">=25",
		"fabric-api": "${fabric_api_version}"
	},
	"suggests": {
		"sodium": "${sodium_version}",
		"iris": "${iris_version}"
	}
}
