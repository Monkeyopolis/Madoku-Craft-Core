{
	"schemaVersion": 1,
	"id": "madoku-craft-api",
	"version": "${version}",
	"name": "Madoku Craft API",
	"description": "A Shared Library MOD used by Madoku Craft MODs.",
	"authors": [
		"Monkeyopolis"
	],
	"contact": {
		"sources": "https://github.com/Monkeyopolis/Madoku-Craft-API"
	},
	"license": "CC0-1.0",
	"icon": "assets/madoku-craft-api/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"madoku.craft.api.MadokuCraftAPI"
		],
		"client": [
			"madoku.craft.MadokuCraftAPIClient"
		]
	},
	"mixins": [
		"madoku-craft-api.mixins.json",
		"madoku-craft-api.sodium.mixins.json"
	],
	"depends": {
		"fabricloader": "${loader_version}",
		"minecraft": "~${minecraft_version}",
		"java": ">=25",
		"fabric-api": "${fabric_api_version}"
	},
	"suggests": {
		"sodium": "${sodium_version}",
		"iris": "${iris_version}"
	}
}
