{
	"schemaVersion": 1,
	"id": "madoku-craft-api",
	"version": "${version}",
	"name": "Madoku Craft API",
	"description": "A Shared Library MOD used by Madoku Craft MODs.",
	"authors": [
		"Monkeyopolis"
	],
	"contact": {
		"homepage": "https://www.curseforge.com/minecraft/mc-mods/madoku-craft",
		"sources": "https://github.com/Monkeyopolis/Madoku-Craft-API"
	},
	"license": "CC0-1.0",
	"icon": "assets/madoku-craft-api/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"madoku.craft.API.MadokuCraftAPI"
		],
		"client": [
			"madoku.craft.API.MadokuCraftAPIClient"
		]
	},
	"mixins": [
		"madoku-craft-api.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.18.4",
		"minecraft": "~${minecraft_version}",
		"java": ">=21",
		"fabric-api": "*"
	}
}
